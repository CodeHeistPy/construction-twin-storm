# Copy to .env.local (gitignored) to override. Every value is optional: with
# nothing set, the app runs on the Denver Office Park defaults in
# src/config/site.ts.

# --- Scene -------------------------------------------------------------------
# Portal item id of the WebScene (site, terrain, BIM, reality capture).
VITE_WEBSCENE_ID=
VITE_PORTAL_URL=

# --- Site --------------------------------------------------------------------
VITE_SITE_NAME=
VITE_SITE_LON=
VITE_SITE_LAT=
# IANA time zone for clock labels, e.g. America/Chicago
VITE_SITE_TZ=

# --- Demo --------------------------------------------------------------------
# The storm day in the model's calendar (YYYY-MM-DD); defaults to 2026-05-11.
VITE_DEMO_DATE=
# imperial | metric
VITE_UNITS=
