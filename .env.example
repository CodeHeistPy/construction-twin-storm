# Copy to .env.local (gitignored) and fill in. Every value is optional: with
# nothing set, the app runs on a placeholder site with sample data.

# --- Scene -------------------------------------------------------------------
# Portal item id of the WebScene (site, terrain, BIM, reality capture).
# Empty = basemap + world elevation only.
VITE_WEBSCENE_ID=
VITE_PORTAL_URL=https://www.arcgis.com

# --- Site --------------------------------------------------------------------
VITE_SITE_NAME=
VITE_SITE_LON=
VITE_SITE_LAT=
# IANA time zone for clock labels, e.g. America/Chicago
VITE_SITE_TZ=America/Denver

# --- Demo --------------------------------------------------------------------
# Pin the demo's "today" (YYYY-MM-DD) so the scripted storm and schedule line up.
VITE_DEMO_DATE=
# imperial | metric
VITE_UNITS=imperial
